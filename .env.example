# Copy to .env and fill in values.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=https://www.thenucleus.in
EXPO_PUBLIC_APP_URL=https://www.thenucleus.in

# API tracing — on by default in dev builds. Set to 0 to silence, or 1 in production.
# Filter Metro/Xcode/Android logs by `[api]`. In the debugger console: printApiDebugSummary()
EXPO_PUBLIC_DEBUG_API=1

# Mobile mirrors web: list + body prefetch on category/folder land (~25 threads),
# intent prefetch on press, bulk body warm once per login (concurrency 2).
# EXPO_PUBLIC_DISABLE_MAIL_THREAD_PREFETCH=1 to disable all background body prefetch.
