{
  "name": "placecom-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "bash scripts/run-android.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev:android": "eas build --profile development --platform android",
    "build:store:android": "eas build --profile production --platform android",
    "build:apk:android": "eas build --profile production-apk --platform android",
    "build:local:android": "bash scripts/eas-build-local.sh production android",
    "build:local:apk:android": "bash scripts/eas-build-local.sh production-apk android",
    "build:local:dev:android": "bash scripts/eas-build-local.sh development android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/drawer": "^7.5.0",
    "@supabase/supabase-js": "^2.106.0",
    "date-fns": "^4.2.1",
    "expo": "54.0.34",
    "expo-audio": "1.1.1",
    "expo-auth-session": "7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "18.0.13",
    "expo-dev-client": "6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.22",
    "expo-image-picker": "17.0.11",
    "expo-linking": "8.0.12",
    "expo-modules-core": "3.0.30",
    "expo-notifications": "~0.32.17",
    "expo-router": "6.0.23",
    "expo-secure-store": "15.0.8",
    "expo-sharing": "14.0.8",
    "expo-status-bar": "3.0.9",
    "expo-web-browser": "15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-drawer-layout": "^4.2.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5"
